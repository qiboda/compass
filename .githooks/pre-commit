#!/bin/bash
# pre-commit hook — fast Rust fmt check before commit.
# Full Rust suite runs in pre-push.

has_error=0

echo "pre-commit: cargo fmt --check..."
if ! cargo fmt --check; then
    echo "ERROR: cargo fmt --check found unformatted code."
    echo "  Run 'cargo fmt' and commit the changes."
    has_error=1
fi

if [ $has_error -ne 0 ]; then
    echo ""
    echo "     cargo fmt"
    exit 1
fi
exit 0
