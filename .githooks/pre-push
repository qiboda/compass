#!/bin/bash
# pre-push hook — verify quality gates and GitHub issue references.
#
# 1. cargo fmt (must be clean)
# 2. cargo clippy (must be warning-free)
# 3. cargo doc (must be warning-free)
# 4. "ref #N" in commit messages must point to open issues
# 5. Python lint + tests (if collectors/pyproject.toml exists)
#
# CI gating for PRs is enforced by branch protection on master
# (9 required status checks, strict) — see kb/dev/process.md.
# This hook intentionally does NOT check master CI status: that check
# deadlocked fix-PR pushes (a failing master CI blocked the very PR that
# would fix it, ref #172).
#
# Matches the pre-push checklist in kb/dev/process.md.

has_error=0

# --- Quality gate: cargo fmt ---
echo "pre-push: cargo fmt --check..."
if ! cargo fmt --check; then
    echo ""
    echo "ERROR: cargo fmt --check found unformatted code."
    echo "  Run 'cargo fmt' and commit the changes."
    echo ""
    has_error=1
fi

# --- Quality gate: cargo clippy ---
echo "pre-push: cargo clippy -- -D warnings..."
if ! cargo clippy -- -D warnings 2>&1; then
    echo ""
    echo "ERROR: cargo clippy produced warnings."
    echo "  Fix clippy warnings before pushing."
    echo ""
    has_error=1
fi

# --- Quality gate: cargo doc ---
echo "pre-push: cargo doc --no-deps (must be warning-free)..."
if ! RUSTDOCFLAGS="-D warnings" cargo doc --no-deps 2>&1; then
    echo ""
    echo "ERROR: cargo doc produced warnings or errors."
    echo "  Add /// doc comments to all public items and re-run."
    echo ""
    has_error=1
fi

# --- Quality gate: Python lint + test ---
if [ -d "collectors" ] && [ -f "collectors/pyproject.toml" ]; then
    echo "pre-push: Python ruff check..."
    if ! (cd collectors && uv run ruff check *.py tests/ 2>&1); then
        echo ""
        echo "ERROR: Python lint found issues."
        echo "  Run: cd collectors && uv run ruff check *.py tests/ --fix"
        echo ""
        has_error=1
    fi

    echo "pre-push: Python pytest..."
    if ! (cd collectors && uv run pytest tests/ -q 2>&1); then
        echo ""
        echo "ERROR: Python tests failed."
        echo "  Run: cd collectors && uv run pytest tests/ -v"
        echo ""
        has_error=1
    fi
fi

# --- Issue reference validation ---

while read -r local_ref local_oid remote_ref remote_oid; do
    # Skip branch deletion
    if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Nothing new to push
    if [ "$remote_oid" = "$local_oid" ]; then
        continue
    fi

    # Determine commit range — only scan commits unique to this push.
    # For new branches, find the merge-base with origin/master so we
    # don't scan the entire reachable history.
    # Always exclude commits already on origin/master (e.g. after a rebase,
    # master's commits — with their closed-issue refs — must not be rescanned).
    # NOTE: $range holds a bare revision range (no spaces); the exclusion is
    # appended at each git log call site so git parses it as a separate arg.
    if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
        base=$(git merge-base origin/master "$local_oid" 2>/dev/null \
            || git merge-base origin/main "$local_oid" 2>/dev/null \
            || echo "")
        if [ -n "$base" ]; then
            range="${base}..${local_oid}"
        else
            range="$local_oid"
        fi
    else
        range="${remote_oid}..${local_oid}"
    fi
    # Exclusion applied at call sites: git log $range --not origin/master
    excl_origin="--not origin/master"

    # Detect malformed ref references: standalone "ref" not followed by #N.
    # ref must be preceded by line start, whitespace, or '(' — legal refs only
    # appear there. This excludes code/term fragments like --abbrev-ref,
    # \<ref\>, or refactored (ref #97).
    all_refs=$(git log "$range" $excl_origin --format="%B" 2>/dev/null | grep -ciE '(^|[[:space:](])ref[[:space:]]+')
    valid_refs=$(git log "$range" $excl_origin --format="%B" 2>/dev/null | grep -ciE '(^|[[:space:](])ref[[:space:]]+#[0-9]+')

    if [ "$all_refs" -gt "$valid_refs" ]; then
        echo ""
        echo "ERROR: malformed 'ref' reference in commit message."
        echo "  Found 'ref' without a valid GitHub issue number."
        echo "  Use 'ref #N' format (e.g., 'ref #23')."
        echo "  If this is a chore/docs/test commit, remove the 'ref' keyword entirely."
        echo ""
        has_error=1
        continue
    fi

    # Extract issue references from all commits in the range.
    # Only standalone-line refs count (ref #211): a line containing nothing but
    # the ref reference. Inline "ref #N" in prose is a narrative mention and is
    # deliberately excluded — it may reference closed issues.
    issues=$(git log "$range" $excl_origin --format="%B" 2>/dev/null \
        | grep -iE '^[[:space:]]*ref[[:space:]]+#[0-9]+([[:space:]]*,[[:space:]]*#[0-9]+)*[[:space:]]*$' \
        | grep -oE '#[0-9]+' \
        | tr -d '#' \
        | sort -u \
        || true)

    if [ -z "$issues" ]; then
        echo ""
        echo "ERROR: push rejected — no 'ref #N' found in commit messages."
        echo "  Every commit must reference an open GitHub issue."
        echo "  Add 'ref #N' on its own line to at least one commit in this push."
        echo "  Inline 'ref #N' in prose does not count (ref #211)."
        echo ""
        has_error=1
        continue
    fi

    for n in $issues; do
        state=$(unset GITHUB_TOKEN 2>/dev/null; gh issue view "$n" --repo qiboda/compass --json state --jq '.state' 2>/dev/null || echo "MISSING")

        if [ "$state" != "OPEN" ]; then
            echo ""
            echo "ERROR: push rejected — issue #$n is $state (must be OPEN)."
            echo ""
            if [ "$state" = "MISSING" ]; then
                echo "  Issue #$n does not exist. Create it with 'gh issue create'."
            else
                echo "  Issue #$n is $state. Reopen it with 'gh issue reopen $n'."
            fi
            echo ""
            has_error=1
        fi
    done
done

if [ $has_error -ne 0 ]; then
    exit 1
fi
exit 0
