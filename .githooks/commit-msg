#!/bin/bash
# commit-msg hook — enforce issue references for feat/fix commits.
#
# feat: commits must reference an issue via "closes #N"
# fix:  commits must reference an issue via "fixes #N"
# Other types (test, refactor, docs, chore) are exempt.

COMMIT_MSG_FILE="$1"

# Skip merge and revert commits
head -1 "$COMMIT_MSG_FILE" | grep -qE "^(Merge|Revert)" && exit 0

# Extract subject line
SUBJECT=$(head -1 "$COMMIT_MSG_FILE")

# Check feat: requires "closes #N"
if echo "$SUBJECT" | grep -qE "^feat[(!]*: "; then
    if ! grep -qiE "closes[[:space:]]+#[0-9]+" "$COMMIT_MSG_FILE"; then
        echo "ERROR: feat commits must reference a GitHub issue with 'closes #N' in the body."
        echo ""
        echo "  Example:"
        echo "    feat: add thing"
        echo ""
        echo "    closes #1"
        echo ""
        exit 1
    fi
    exit 0
fi

# Check fix: requires "fixes #N"
if echo "$SUBJECT" | grep -qE "^fix[(!]*: "; then
    if ! grep -qiE "fixes[[:space:]]+#[0-9]+" "$COMMIT_MSG_FILE"; then
        echo "ERROR: fix commits must reference a GitHub issue with 'fixes #N' in the body."
        echo ""
        echo "  Example:"
        echo "    fix: correct thing"
        echo ""
        echo "    fixes #1"
        echo ""
        exit 1
    fi
    exit 0
fi

# All other types (test, refactor, docs, chore, etc.) — pass
exit 0
