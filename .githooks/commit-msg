#!/bin/bash
# commit-msg hook — enforce issue references for all commits.
#
# Every commit MUST reference an issue via "ref #N".
# No exceptions — feat, fix, test, docs, chore all included.

COMMIT_MSG_FILE="$1"

# Skip merge and revert commits
head -1 "$COMMIT_MSG_FILE" | grep -qE "^(Merge|Revert)" && exit 0

if ! grep -qiE "ref[[:space:]]+#[0-9]+" "$COMMIT_MSG_FILE"; then
    echo "ERROR: every commit must reference a GitHub issue with 'ref #N'."
    echo ""
    echo "  Example:"
    echo "    feat: add thing"
    echo ""
    echo "    ref #1"
    echo ""
    exit 1
fi

exit 0
