#!/bin/bash
# commit-msg hook — enforce issue references for feat/fix commits.
#
# feat/fix: commits must reference an issue via "ref #N"
# Other types (test, refactor, docs, chore) are exempt.

COMMIT_MSG_FILE="$1"

# Skip merge and revert commits
head -1 "$COMMIT_MSG_FILE" | grep -qE "^(Merge|Revert)" && exit 0

# Extract subject line
SUBJECT=$(head -1 "$COMMIT_MSG_FILE")

# Check feat/fix: requires "ref #N"
if echo "$SUBJECT" | grep -qE "^(feat|fix)[(!]*: "; then
    if ! grep -qiE "ref[[:space:]]+#[0-9]+" "$COMMIT_MSG_FILE"; then
        echo "ERROR: feat/fix commits must reference a GitHub issue with 'ref #N' in the body."
        echo ""
        echo "  Example:"
        echo "    feat: add thing"
        echo ""
        echo "    ref #1"
        echo ""
        exit 1
    fi
    exit 0
fi

# All other types (test, refactor, docs, chore, etc.) — pass
exit 0
